@echo off
setlocal enabledelayedexpansion

:: ============================================================
::  FFVM Benchmark Runner
::  Usage: run-benchmarks.cmd [output.md]
::  Default output: benchmarks/benchmark_results.md
:: ============================================================

set "OUTPUT=%~1"
if "%OUTPUT%"=="" set "OUTPUT=benchmarks\benchmark_results.md"

:: ensure output directory exists
for %%F in ("%OUTPUT%") do (
    if not exist "%%~dpF" mkdir "%%~dpF"
)

:: Resolve root directory (parent of benchmarks/)
for %%D in ("%~dp0..") do set "ROOT=%%~fD"
set "RUNNER=StandaloneRunner"
set "RAW=%TEMP%\ffvm_bench_raw.txt"

:: Work from root so relative OUTPUT path is correct
cd /d "%ROOT%"

echo [*] Building and running benchmarks...

:: Note: --artifacts-path removed; it caused process-start failures on some
:: environments.  If LSP file locks are a problem, stop the LSP server first.
dotnet run --project "%ROOT%\%RUNNER%\StandaloneRunner.csproj" -c Release -- --bench > "%RAW%" 2>&1

:: ?? parse environment line ??
set "ENV_LINE="
for /f "tokens=*" %%L in ('findstr /c:"[BENCHMARK_ENV]" "%RAW%"') do set "ENV_LINE=%%L"

:: extract runtime version from ENV_LINE
:: ENV_LINE looks like: [BENCHMARK_ENV] runtime=6.0.22 os=... cores=...
set "RUNTIME=unknown"
if defined ENV_LINE (
    set "_env=!ENV_LINE!"
    set "_env=!_env:*runtime=!"
    set "_env=!_env:~1!"
    for /f "tokens=1 delims= " %%V in ("!_env!") do set "RUNTIME=%%V"
)

:: ?? generate markdown ??
echo [*] Generating %OUTPUT%...

(
    echo # FFVM Benchmark Results
    echo.
    echo ^> Auto-generated by `run-benchmarks.cmd` on %DATE% %TIME%
    echo ^> Runtime: .NET !RUNTIME! ^| OS: %OS% ^| CPU cores: %NUMBER_OF_PROCESSORS%
    echo ^> Warmup: 100 runs, Measure: 200 runs, Release build
    echo.
    echo ## Test Descriptions
    echo.
    echo ^| ID ^| Name ^| Description ^|
    echo ^|---^|---^|---^|
    echo ^| B01 ^| ArithLoop ^| 10K iterations: ADD/MUL/SUB/MOD + conditional SYSCALL ^|
    echo ^| B02 ^| Fibonacci ^| Iterative fib^(250^): swap loop ^|
    echo ^| B03 ^| NestedLoop ^| 100x100 nested loop with multiply-accumulate ^|
    echo ^| B04 ^| Branching ^| 10K iterations: 4-way if/else-if chain ^|
    echo ^| B05 ^| Accumulator ^| 50K iterations: pure ADD loop ^(dispatch overhead indicator^) ^|
    echo ^| B06 ^| FuncCall ^| 5K iterations: function call per iteration ^(CALL/RET overhead^) ^|
    echo.
    echo ## Results
    echo.
    echo Both sides use `Number` struct ^(8B, float mode^) for fair comparison.
    echo FFVM script and C# execute **identical logic** with the same data types.
    echo.
    echo ^| Benchmark ^| VM ^(us^) ^| C# ^(us^) ^| Ratio ^| Scale ^| Instrs ^| Status ^|
    echo ^|---^|---^|---^|---^|---^|---^|---^|
) > "%OUTPUT%"

set "PASS_COUNT=0"
set "FAIL_COUNT=0"

for /f "tokens=*" %%L in ('findstr /c:"[BENCHMARK] B" "%RAW%"') do (
    set "LINE=%%L"
    :: strip prefix "[BENCHMARK] "
    set "DATA=!LINE:*[BENCHMARK] =!"

    :: check for errors � write to temp file to avoid pipe interpretation
    echo "!DATA!" > "%TEMP%\ffvm_bench_chk.txt"
    findstr /c:"COMPILE_ERROR" /c:"MISMATCH" "%TEMP%\ffvm_bench_chk.txt" >nul 2>&1
    if !errorlevel! equ 0 (
        :: error line
        for /f "tokens=1,2,* delims=|" %%A in ("!DATA!") do (
            set "BNAME=%%A"
            set "BSTATUS=%%B"
            set "BDETAIL=%%C"
        )
        set "BNAME=!BNAME: =!"
        (echo ^| !BNAME! ^| - ^| - ^| - ^| - ^| - ^| FAIL: !BSTATUS! ^|) >> "%OUTPUT%"
        set /a FAIL_COUNT+=1
    ) else (
        :: success: name | vm_us | cs_us | ratio | scale | instrs
        for /f "tokens=1,2,3,4,5,6 delims=|" %%A in ("!DATA!") do (
            set "BNAME=%%A"
            set "BVM=%%B"
            set "BCS=%%C"
            set "BRATIO=%%D"
            set "BSCALE=%%E"
            set "BINSTR=%%F"
        )
        :: trim spaces
        set "BNAME=!BNAME: =!"
        set "BVM=!BVM: =!"
        set "BCS=!BCS: =!"
        set "BRATIO=!BRATIO: =!"
        set "BSCALE=!BSCALE: =!"
        set "BINSTR=!BINSTR: =!"
        (echo ^| !BNAME! ^| !BVM! ^| !BCS! ^| !BRATIO!x ^| !BSCALE! ^| !BINSTR! ^| PASS ^|) >> "%OUTPUT%"
        set /a PASS_COUNT+=1
    )
)

(
    echo.
    echo ## Summary
    echo.
    echo - **!PASS_COUNT!** benchmarks passed, **!FAIL_COUNT!** failed
    echo - All values in microseconds ^(us^). Lower is better.
    echo - Ratio = VM / C#. Closer to 1.0x is better.
    echo - Both sides use `Number` struct for fair data-type comparison.
    echo - If compared to raw `float` C#, expect ~10-15x ratio.
    echo.
    echo ## Raw Output
    echo.
    echo ```
    type "%RAW%"
    echo ```
) >> "%OUTPUT%"

echo.
echo [*] Results: !PASS_COUNT! passed, !FAIL_COUNT! failed
echo [*] Report saved to: %OUTPUT%
echo.
type "%OUTPUT%"

endlocal
