// ============================================================
// FFScript Sandbox — Demo Script
// ============================================================
// This script demonstrates all predefined sandbox syscalls.
// Run with: dotnet run -- --run
// Debug with: F5 in VSCode (see README.md)

// Simple function call (demonstrates leaf function optimization)
func add(a: int, b: int): int {
    return a + b
}

func main() {
    // --- Basic printing ---
    print(42)
    print(3.14)

    // --- Labeled printing ---
    // Label IDs: 0=result, 1=value, 2=count, 3=time, 8=x, 9=y, 10=sum
    print_str(0, 100)
    print_str(8, 25)
    print_str(9, 50)

    // --- Math syscalls ---
    var neg: int = -7
    var pos: int = abs(neg)
    print_str(0, pos)

    print_str(14, min(10, 20))
    print_str(15, max(10, 20))

    print_str(0, clamp(50, 0, 30))
    print_str(0, sqrt(144))

    // --- Random ---
    print_str(0, random(100))

    // --- Time ---
    print_str(3, time())

    // --- Frame count ---
    print_str(5, frame_count())

    // --- Function call example ---
    var added: int = add(17, 25)
    print_str(0, added)

    // --- Computation example: sum 1..100 ---
    var sum: int = 0
    var i: int = 1
    while i <= 100 {
        sum = sum + i
        i = i + 1
    }
    print_str(10, sum)

    print(0)
}
