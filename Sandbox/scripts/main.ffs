// ============================================================
// FFScript Sandbox — Demo Script
// ============================================================
// This script demonstrates all predefined sandbox syscalls.
// Run with: dotnet run -- --run
// Debug with: F5 in VSCode (see README.md)

// Simple function call (demonstrates leaf function optimization)
/// Adds two integers and returns the result.
/// @param a The first operand
/// @param b The second operand
/// @return The sum of a and b
func add(a: int, b: int): int {
    return a + b
}

func main() {


    // --- Basic printing ---
    print(42)
    print(3.14)

    // --- Labeled printing (using string constants) ---
    print_str("result", 100)
    print_str("x", 25)
    print_str("y", 50)

    // --- Math syscalls ---
    var neg: int = -7
    var pos: int = abs(neg)
    print_str("result", pos)

    print_str("min", min(10, 20))
    print_str("max", max(10, 20))

    print_str("result", clamp(50, 0, 30))
    print_str("result", sqrt(144))

    // --- Random ---
    print_str("result", random(100))

    // --- Time ---
    print_str("time", time())

    // --- Frame count ---
    print_str("frame", frame_count())

    // --- Function call example ---
    var added: int = add(17, 25)
    print_str("result", added)

    // --- Computation example: sum 1..100 (while loop) ---
    var sum: int = 0
    var i: int = 1
    while i <= 100 {
        sum = sum + i
        i = i + 1
    }
    print_str("sum", sum)

    // --- For loop example: factorial of 5 ---
    var fact: int = 1
    for var j: int = 1; j <= 5; j = j + 1 {
        fact = fact * j
    }
    print_str("result", fact)

    print(0)
}
