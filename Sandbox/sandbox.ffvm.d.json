                { "name": "hi", "type": "number" }
            ],
            "returnType": "number",
            "description": "Clamp value between lo and hi"
        },
        "sqrt": {
            "params": [
                { "name": "value", "type": "number" }
            ],
            "returnType": "number",
            "description": "Return the approximate square root"
        },
        "frame_count": {
            "params": [],
            "returnType": "int",
            "description": "Get the current frame number"
        },
        "exit": {
            "params": [],
            "returnType": "void",
            "description": "Request the sandbox to stop running"
        }
