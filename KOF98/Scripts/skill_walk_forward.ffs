// ============================================================
// Skill: Walk (skill_walk_forward)
// ============================================================
// Sets horizontal velocity each frame based on directional input.
// Activation: Left or Right held, Up not held, grounded.
// Continuation: script checks each frame — returns when input released.
// Deactivation: script return → VM instance completes → host deactivates.

include "common/skill_base.ffs"

// ── Skill Configuration (overrides only) ────────────────────
@export const priority: int = 1
@export const tags: int = TAG_BIT_WALK
@export const activationPriority: int = 500
@export const interruptPriority: int = 500
@export const requireGrounded: int = 1
@export const requireInputHeld: int = INPUT_BIT_ANY_DIR_H
@export const requireNotInputHeld: int = INPUT_BIT_UP

func main() {
    // ── Execution ───────────────────────────────────────────
    defer {
        SetVelocity(0.0, 0.0)
    }

    while 1 {
        // Continuation check — return when direction released or not grounded
        var leftHeld: int = IsInputHeld(INPUT_LEFT)
        var rightHeld: int = IsInputHeld(INPUT_RIGHT)
        var grounded: int = IsGrounded()
        if leftHeld == 0 && rightHeld == 0 { return }
        if grounded == 0 { return }

        // Walk logic
        var rawDir: float = getMoveDirX()
        var inputDir: int = GetInputDir()

        if rawDir == 0.0 {
            SetVelocity(0.0, 0.0)
        } else {
            var speed: float = WALK_SPEED
            if inputDir < 0 { speed = BACK_WALK_SPEED }
            var vx: float = speed * rawDir
            SetVelocity(vx, 0.0)
        }

        yield
    }
}
