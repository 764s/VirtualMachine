// ============================================================
// Skill: Walk (skill_walk_forward)
// Type: Looping  |  Priority: 500 (movement)
// ============================================================
// Sets horizontal velocity each frame based on directional input.
// Activation/deactivation conditions handled by host (CanActivate/CanContinue).
// This script replaces the host OnFrame callback.
//
// Syscalls used: IsInputHeld, GetInputDir, GetFacing, SetVelocity

include "common/input.ffs"

func main() {
    while 1 {
        var rawDir: float = getMoveDirX()
        var inputDir: int = GetInputDir()

        if rawDir == 0.0 {
            // Both directions held or none — zero velocity
            SetVelocity(0.0, 0.0)
        } else {
            // Forward vs backward speed
            var speed: float = WALK_SPEED
            if inputDir < 0 { speed = BACK_WALK_SPEED }
            var vx: float = speed * rawDir
            SetVelocity(vx, 0.0)
        }

        yield
    }
}
