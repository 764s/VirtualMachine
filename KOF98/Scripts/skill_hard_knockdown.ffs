// ============================================================
// Skill: Hard Knockdown (skill_hard_knockdown)
// ============================================================
// 60-frame knockdown state. The character is on the ground.
// After the knockdown duration, the script returns and the host
// transitions to the stand-up skill.
// Activated by host (triggered by DamageType.KNOCKDOWN hit reaction).

include "common/skill_base.ffs"

// ── Skill Configuration (overrides only) ────────────────────
@export const totalFrames: int = 60
@export const priority: int = 2
@export const tags: int = TagBit.KNOCKDOWN
@export const isLooping: int = 0
@export const activationPriority: int = 50
@export const interruptPriority: int = 50
@export const allowedStances: int = Stance.GROUNDED | Stance.KNOCKDOWN

func main() {
    // ── Execution ───────────────────────────────────────────
    BeginAction(30, 60)
    defer {
        EndAction()
    }

    // Impact effect
    SpawnEffectSelf(FxId.HURT_EFFECT, FxDuration.HURT)

    // Lie on ground for the full duration
    var f: int = 0
    while f < 60 {
        f = f + 1
        yield
    }
    // Script return → host will activate stand_up skill
}
