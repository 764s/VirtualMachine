// ============================================================
// Skill: Hard Knockdown (skill_hard_knockdown)
// ============================================================
// 60-frame knockdown state. The character is on the ground.
// After the knockdown duration, the script returns and the host
// transitions to the stand-up skill.
// Activated by host (triggered by DMG_KNOCKDOWN hit reaction).

include "common/skill_base.ffs"

func main() {
    // ── Skill Configuration ─────────────────────────────────
    SetSkillMeta(META_TOTAL_FRAMES, 60)
    SetSkillMeta(META_PRIORITY, 2)
    SetSkillMeta(META_TAGS, 512)
    SetSkillMeta(META_IS_LOOPING, 0)
    SetSkillMeta(META_ACTIVATION_PRIORITY, 50)
    SetSkillMeta(META_INTERRUPT_PRIORITY, 50)
    SetSkillMeta(META_ALLOWED_STANCES, 9)

    // ── Execution ───────────────────────────────────────────
    BeginAction(30, 60)
    defer {
        EndAction()
    }

    // Impact effect
    SpawnEffectSelf(FX_HURT_EFFECT, FX_DUR_HURT)

    // Lie on ground for the full duration
    var f: int = 0
    while f < 60 {
        f = f + 1
        yield
    }
    // Script return → host will activate stand_up skill
}
