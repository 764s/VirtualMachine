// ============================================================
// Skill: Light Punch (skill_light_punch)
// ============================================================
// 20-frame attack. Hitbox active during frames [5, 10).
// Collision data is organized as structs (Box4, HitPhaseDef) via
// skill_collision.ffs and pushed to host each frame via syscalls.
// Activation: LP pressed, grounded.

include "common/skill_base.ffs"

// ── Skill Configuration (overrides only) ────────────────────
@export const totalFrames: int = 20
@export const priority: int = 3
@export const tags: int = TAG_BIT_ATTACK
@export const isLooping: int = 0
@export const activationPriority: int = 200
@export const interruptPriority: int = 200
@export const requireGrounded: int = 1
@export const requireInputPressed: int = INPUT_BIT_LP

// ── Collision Configuration (module constants) ──────────────
const hitPhase: HitPhaseDef = HitPhaseDef {
    startFrame: 5,
    endFrame: 10,
    groupId: 1001,
    box: Box4 { ox: 0.3, oy: 0.5, hw: 0.25, hh: 0.15 }
}

const hurtBox: Box4 = Box4 { ox: 0.0, oy: 0.55, hw: 0.2, hh: 0.5 }

func main() {
    // ── Execution ───────────────────────────────────────────
    BeginAction(10, 20)
    defer {
        ClearHitbox()
        EndAction()
    }

    var f: int = 0
    var hitDone: int = 0
    while f < 20 {
        // Push collision for this frame
        applyHurtbox(hurtBox)
        clearHitbox()
        pushHitPhase(f, hitPhase)

        // Hit detection during active window
        if f >= hitPhase.startFrame && f < hitPhase.endFrame && hitDone == 0 {
            var target: int = CheckAttackHit(hitPhase.groupId)
            if target > 0 {
                ApplyDamage(target, 1.0, DMG_NORMAL_UPPER)
                hitDone = 1
            }
        }
        f = f + 1
        yield
    }
}
