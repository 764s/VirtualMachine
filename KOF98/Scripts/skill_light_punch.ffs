// ============================================================
// Skill: Light Punch (skill_light_punch)
// ============================================================
// 20-frame attack. Hitbox active during frames [5, 10).
// Collision frames are defined on the SkillDef (host-side) and
// applied via SkillManager.UpdateCollisionBoxes each frame.
// This script checks for hit within the active window and applies damage.
// Activation: LP pressed, grounded.

include "common/skill_base.ffs"

// ── Skill Configuration (overrides only) ────────────────────
@export var totalFrames: int = 20
@export var priority: int = 3
@export var tags: int = TAG_BIT_ATTACK
@export var isLooping: int = 0
@export var activationPriority: int = 200
@export var interruptPriority: int = 200
@export var requireGrounded: int = 1
@export var requireInputPressed: int = INPUT_BIT_LP

func main() {
    // ── Execution ───────────────────────────────────────────
    BeginAction(10, 20)
    defer {
        EndAction()
    }

    var f: int = 0
    var hitDone: int = 0
    while f < 20 {
        // Hitbox active during frames [5, 10) — group ID 1001
        if f >= 5 && f < 10 && hitDone == 0 {
            var target: int = CheckAttackHit(1001)
            if target > 0 {
                ApplyDamage(target, 1.0, DMG_NORMAL_UPPER)
                hitDone = 1
            }
        }
        f = f + 1
        yield
    }
}
