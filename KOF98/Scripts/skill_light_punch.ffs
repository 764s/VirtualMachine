// ============================================================
// Skill: Light Punch (skill_light_punch)
// ============================================================
// 20-frame attack. Hitbox active during frames [5, 10).
// Collision frames are defined on the SkillDef (host-side) and
// applied via SkillManager.UpdateCollisionBoxes each frame.
// This script checks for hit within the active window and applies damage.
// Activation: LP pressed, grounded.

include "common/skill_base.ffs"

func main() {
    // ── Skill Configuration ─────────────────────────────────
    SetSkillMeta(META_TOTAL_FRAMES, 20)
    SetSkillMeta(META_PRIORITY, 3)
    SetSkillMeta(META_TAGS, 32)
    SetSkillMeta(META_IS_LOOPING, 0)
    SetSkillMeta(META_ACTIVATION_PRIORITY, 200)
    SetSkillMeta(META_INTERRUPT_PRIORITY, 200)
    SetSkillMeta(META_ALLOWED_STANCES, STANCE_GROUNDED)
    SetSkillMeta(META_REQUIRE_GROUNDED, 1)
    SetSkillMeta(META_REQUIRE_INPUT_PRESSED, INPUT_BIT_LP)

    // ── Execution ───────────────────────────────────────────
    BeginAction(10, 20)
    defer {
        EndAction()
    }

    var f: int = 0
    var hitDone: int = 0
    while f < 20 {
        // Hitbox active during frames [5, 10) — group ID 1001
        if f >= 5 && f < 10 && hitDone == 0 {
            var target: int = CheckAttackHit(1001)
            if target > 0 {
                ApplyDamage(target, 1.0, DMG_NORMAL_UPPER)
                hitDone = 1
            }
        }
        f = f + 1
        yield
    }
}
