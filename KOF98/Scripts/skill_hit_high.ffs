// ============================================================
// Skill: Hit High (skill_hit_high)
// ============================================================
// 30-frame hit reaction for upper-body hits.
// Passive script: activated by host when character receives a
// DamageType.NORMAL_UPPER or similar hit while standing.
// Plays the hit animation and spawns a visual effect, then returns.

include "common/skill_base.ffs"

// ── Skill Configuration (overrides only) ────────────────────
override @export const totalFrames: int = 30
override @export const priority: int = 2
override @export const tags: int = TagBit.HIT
override @export const isLooping: int = 0
override @export const activationPriority: int = 100
override @export const interruptPriority: int = 100

func main() {
    // ── Execution ───────────────────────────────────────────
    BeginAction(25, 30)
    defer {
        EndAction()
    }

    

    // Visual feedback: spawn hit effect on self
    SpawnEffectSelf(FxId.HURT_EFFECT, FxDuration.HURT)

    // Wait for the hit animation to complete
    var f: int = 0
    while f < 30 {
        f = f + 1
        yield
    }
}
