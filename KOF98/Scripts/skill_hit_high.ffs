// ============================================================
// Skill: Hit High (skill_hit_high)
// ============================================================
// 30-frame hit reaction for upper-body hits.
// Passive script: activated by host when character receives a
// DMG_NORMAL_UPPER or similar hit while standing.
// Plays the hit animation and spawns a visual effect, then returns.

include "common/skill_base.ffs"

// ── Skill Configuration (overrides only) ────────────────────
@export var totalFrames: int = 30
@export var priority: int = 2
@export var tags: int = TAG_BIT_HIT
@export var isLooping: int = 0
@export var activationPriority: int = 100
@export var interruptPriority: int = 100

func main() {
    // ── Execution ───────────────────────────────────────────
    BeginAction(25, 30)
    defer {
        EndAction()
    }

    // Visual feedback: spawn hit effect on self
    SpawnEffectSelf(FX_HURT_EFFECT, FX_DUR_HURT)

    // Wait for the hit animation to complete
    var f: int = 0
    while f < 30 {
        f = f + 1
        yield
    }
}
