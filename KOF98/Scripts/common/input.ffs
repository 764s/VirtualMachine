// ============================================================
// KOF98 Input Helpers
// ============================================================
// Shared input utility functions for skill scripts.
//
// Usage:  include "common/input.ffs"
//
// Note: This file includes constants.ffs for InputButton enum.
// ============================================================

include "common/constants.ffs"

// ── Direction Helpers ────────────────────────────────────────

/// Returns the horizontal movement direction as a float:
///   +1.0 = right only, -1.0 = left only, 0.0 = both or neither.
func getMoveDirX(): float {
    var rightHeld: int = IsInputHeld(InputButton.RIGHT)
    var leftHeld: int = IsInputHeld(InputButton.LEFT)
    if rightHeld != 0 && leftHeld == 0 { return 1.0 }
    if leftHeld != 0 && rightHeld == 0 { return -1.0 }
    return 0.0
}
