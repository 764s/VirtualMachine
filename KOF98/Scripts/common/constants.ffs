// ============================================================
// KOF98 Shared Constants
// ============================================================
// Include this file in skill scripts to eliminate magic numbers.
//
// Usage:  include "common/constants.ffs"
//
// Categories:
//   - Host syscall declarations (via kof98_syscalls.ffs)
//   - Damage types: enum DamageType (Lang-13)
//   - Effect / SFX IDs: enum FxId (Lang-13)
//   - Effect durations: enum FxDuration (Lang-13)
//   - Input button indices: enum InputButton (Lang-13)
//   - Tag IDs (TAG_*)
//   - Movement parameters (WALK_SPEED, etc.)
// ============================================================

include "common/kof98_syscalls.ffs"

// ── Damage Types (Lang-13 enum) ──────────────────────────────
enum DamageType {
    NONE         = 0,
    NORMAL_LOWER = 101,
    NORMAL_UPPER = 102,
    KNOCKDOWN    = 201,
    THROW        = 301,
    SUPER        = 401
}

// ── Effect / SFX IDs (Lang-13 enum) ─────────────────────────
enum FxId {
    LIGHT_HIT      = 3001,
    SCREEN_SHAKE_S = 3002,
    HEAVY_HIT_SFX  = 3003,
    BLOCK          = 3004,
    HEAVY_HIT      = 3005,
    HURT_EFFECT    = 4001
}

// ── Effect Durations in frames (Lang-13 enum) ───────────────
enum FxDuration {
    LIGHT_HIT = 30,
    HURT      = 300
}

// ── Input Button Indices (Lang-13 enum) ─────────────────────
// Maps to InputButton enum values used by IsInputHeld/IsInputPressed.
enum InputButton {
    UP,
    DOWN,
    LEFT,
    RIGHT,
    LP,
    HP,
    LK,
    HK
}

// ── Tag IDs (skill tag bitfield positions) ───────────────────
const TAG_AIR_STATE: int = 11

// ── Movement Parameters ─────────────────────────────────────
const WALK_SPEED: float = 0.06
const BACK_WALK_SPEED: float = 0.04
const JUMP_VY: float = 0.35
