// ============================================================
// KOF98 Shared Constants
// ============================================================
// Include this file in skill scripts to eliminate magic numbers.
//
// Usage:  include "common/constants.ffs"
//
// Categories:
//   - Damage types: enum DamageType (Lang-13)
//   - Effect / SFX IDs: enum FxId (Lang-13)
//   - Tag IDs (TAG_*)
//   - Movement parameters (WALK_SPEED, etc.)
//   - Input button indices (INPUT_*)
// ============================================================

// ── Damage Types (Lang-13 enum) ──────────────────────────────
enum DamageType {
    NONE         = 0,
    NORMAL_LOWER = 101,
    NORMAL_UPPER = 102,
    KNOCKDOWN    = 201,
    THROW        = 301,
    SUPER        = 401
}

// ── Effect / SFX IDs (Lang-13 enum) ─────────────────────────
enum FxId {
    LIGHT_HIT      = 3001,
    SCREEN_SHAKE_S = 3002,
    HEAVY_HIT_SFX  = 3003,
    BLOCK          = 3004,
    HEAVY_HIT      = 3005,
    HURT_EFFECT    = 4001
}

// ── Effect Durations (frames) ───────────────────────────────
const FX_DUR_LIGHT_HIT: int = 30
const FX_DUR_HURT: int = 300

// ── Tag IDs (skill tag bitfield positions) ───────────────────
const TAG_AIR_STATE: int = 11

// ── Movement Parameters ─────────────────────────────────────
const WALK_SPEED: float = 0.06
const BACK_WALK_SPEED: float = 0.04
const JUMP_VY: float = 0.35

// ── Input Button Indices ────────────────────────────────────
// These map to InputButton enum values used by IsInputHeld/IsInputPressed.
const INPUT_UP: int = 0
const INPUT_DOWN: int = 1
const INPUT_LEFT: int = 2
const INPUT_RIGHT: int = 3
const INPUT_LP: int = 4
const INPUT_HP: int = 5
const INPUT_LK: int = 6
const INPUT_HK: int = 7
