// ============================================================
// KOF98 Skill Base Include
// ============================================================
// Common base include for all skill scripts.
// Provides:
//   - Full constant/input chain (via input.ffs → constants.ffs)
//   - Stance bits: enum Stance (Lang-13)
//   - Input bits: enum InputBit (Lang-13)
//   - Tag bits: enum TagBit (Lang-13)
//   - Default @export const declarations (inherited by including scripts)
//
// Usage:  include "common/skill_base.ffs"
//
// Every skill script MUST include this file. The base provides
// sensible defaults for all configuration variables. Scripts only
// need to override values that differ from these defaults.
// The Preprocessor supports cross-file override — the including
// script's declaration replaces the base declaration.
//
// Base defaults:
//   @export const totalFrames: int = -1
//   @export const priority: int = 0
//   @export const tags: int = TagBit.IDLE
//   @export const isLooping: int = 1
//   @export const activationPriority: int = 900
//   @export const interruptPriority: int = 900
//   @export const allowedStances: int = Stance.GROUNDED
// ============================================================

include "common/input.ffs"
include "common/skill_collision.ffs"

// ── Stance Bits (for allowedStances @export const) ────────────
// Bitfield values — combine with | for multi-stance skills (Lang-14).
// Must match Stance enum order in Types.cs.

enum Stance {
    GROUNDED  = 1,
    AIRBORNE  = 2,
    CROUCHING = 4,
    KNOCKDOWN = 8,
    HITSTUN   = 16,
    DEAD      = 32
}

// ── Input Bit Constants (for require* @export consts) ─────────
// Bit values matching InputButton flags in PlayerInput.cs.

enum InputBit {
    UP        = 1,
    DOWN      = 2,
    LEFT      = 4,
    RIGHT     = 8,
    LP        = 16,
    HP        = 32,
    LK        = 64,
    HK        = 128,
    ANY_DIR_H = 12
}

// ── Tag Bit Constants (Lang-14 shift for clarity) ───────────
// Used with tags @export const to declare skill tags.

enum TagBit {
    IDLE      = 1 << 0,
    WALK      = 1 << 1,
    JUMP      = 1 << 4,
    ATTACK    = 1 << 5,
    HIT       = 1 << 6,
    KNOCKDOWN = 1 << 9,
    AIR_STATE = 1 << 11
}

// ── Default Skill Configuration ─────────────────────────────
// Base @export const defaults — including scripts override only what differs.
// The Preprocessor merges cross-file declarations (last declaration wins).

@export const totalFrames: int = -1
@export const priority: int = 0
@export const tags: int = TagBit.IDLE
@export const isLooping: int = 1
@export const activationPriority: int = 900
@export const interruptPriority: int = 900
@export const allowedStances: int = Stance.GROUNDED
