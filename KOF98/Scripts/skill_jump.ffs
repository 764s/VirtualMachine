// ============================================================
// Skill: Jump (skill_jump)
// Type: Finite (physics)  |  Priority: 400 (movement)
// ============================================================
// First frame: sets launch velocity (horizontal from input, vertical fixed).
// Then yields until the character lands (after a grace period).
// Script return → VM instance completes → host deactivates skill.
//
// Activation condition handled by host (CanActivate: Up pressed + grounded).
//
// Syscalls used: IsInputHeld, SetVelocity, IsGrounded

include "common/input.ffs"

func main() {
    // --- Launch (first frame) ---
    var vx: float = getMoveDirX() * WALK_SPEED
    SetVelocity(vx, JUMP_VY)
    yield

    // --- Airborne: wait for landing ---
    // Skip first few frames to avoid false grounded detection
    // (physics needs time to move character above ground)
    var f: int = 1
    while f < 120 {
        if f > 3 {
            var grounded: int = IsGrounded()
            if grounded != 0 { return }
        }
        f = f + 1
        yield
    }
}
