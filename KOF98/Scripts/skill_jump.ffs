// ============================================================
// Skill: Jump (skill_jump)
// ============================================================
// First frame: sets launch velocity (horizontal from input, vertical fixed).
// Then yields until the character lands (after a grace period).
// Script return → VM instance completes → host deactivates skill.
// Activation: Up pressed, grounded.

include "common/skill_base.ffs"

// ── Skill Configuration (overrides only) ────────────────────
@export const totalFrames: int = 120
@export const priority: int = 1
@export const tags: int = TagBit.JUMP | TagBit.AIR_STATE
@export const isLooping: int = 0
@export const activationPriority: int = 400
@export const interruptPriority: int = 500
@export const allowedStances: int = Stance.GROUNDED | Stance.CROUCHING
@export const requireGrounded: int = 1
@export const requireInputPressed: int = InputBit.UP

func main() {
    // ── Execution ───────────────────────────────────────────
    // Launch (first frame)
    var vx: float = getMoveDirX() * WALK_SPEED
    SetVelocity(vx, JUMP_VY)
    yield

    // Airborne: wait for landing
    var f: int = 1
    while f < 120 {
        if f > 3 {
            var grounded: int = IsGrounded()
            if grounded != 0 { return }
        }
        f = f + 1
        yield
    }
}
