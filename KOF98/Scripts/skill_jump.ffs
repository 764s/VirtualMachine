// ============================================================
// Skill: Jump (skill_jump)
// ============================================================
// First frame: sets launch velocity (horizontal from input, vertical fixed).
// Then yields until the character lands (after a grace period).
// Script return → VM instance completes → host deactivates skill.
// Activation: Up pressed, grounded.

include "common/skill_base.ffs"

func main() {
    // ── Skill Configuration ─────────────────────────────────
    SetSkillMeta(META_TOTAL_FRAMES, 120)
    SetSkillMeta(META_PRIORITY, 1)
    SetSkillMeta(META_TAGS, TAG_BIT_JUMP + TAG_BIT_AIR_STATE)
    SetSkillMeta(META_IS_LOOPING, 0)
    SetSkillMeta(META_ACTIVATION_PRIORITY, 400)
    SetSkillMeta(META_INTERRUPT_PRIORITY, 500)
    SetSkillMeta(META_ALLOWED_STANCES, STANCE_GROUNDED + STANCE_CROUCHING)
    SetSkillMeta(META_REQUIRE_GROUNDED, 1)
    SetSkillMeta(META_REQUIRE_INPUT_PRESSED, INPUT_BIT_UP)

    // ── Execution ───────────────────────────────────────────
    // Launch (first frame)
    var vx: float = getMoveDirX() * WALK_SPEED
    SetVelocity(vx, JUMP_VY)
    yield

    // Airborne: wait for landing
    var f: int = 1
    while f < 120 {
        if f > 3 {
            var grounded: int = IsGrounded()
            if grounded != 0 { return }
        }
        f = f + 1
        yield
    }
}
