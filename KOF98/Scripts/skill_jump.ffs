// ============================================================
// Skill: Jump (skill_jump)
// ============================================================
// First frame: sets launch velocity (horizontal from input, vertical fixed).
// Then yields until the character lands (after a grace period).
// Script return → VM instance completes → host deactivates skill.
// Activation: Up pressed, grounded.

include "common/skill_base.ffs"

// ── Skill Configuration ─────────────────────────────────────
@export var totalFrames: int = 120
@export var priority: int = 1
@export var tags: int = TAG_BIT_JUMP + TAG_BIT_AIR_STATE
@export var isLooping: int = 0
@export var activationPriority: int = 400
@export var interruptPriority: int = 500
@export var allowedStances: int = STANCE_GROUNDED + STANCE_CROUCHING
@export var requireGrounded: int = 1
@export var requireInputPressed: int = INPUT_BIT_UP

func main() {
    // ── Execution ───────────────────────────────────────────
    // Launch (first frame)
    var vx: float = getMoveDirX() * WALK_SPEED
    SetVelocity(vx, JUMP_VY)
    yield

    // Airborne: wait for landing
    var f: int = 1
    while f < 120 {
        if f > 3 {
            var grounded: int = IsGrounded()
            if grounded != 0 { return }
        }
        f = f + 1
        yield
    }
}
