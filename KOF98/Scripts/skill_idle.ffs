// ============================================================
// Skill: Idle (skill_idle)
// ============================================================
// Simplest looping script. Yields every frame.
// Activated as fallback when no other skill is active.
// Deactivated when any higher-priority skill activates.

include "common/skill_base.ffs"

// ── Skill Configuration ─────────────────────────────────────
@export var totalFrames: int = -1
@export var priority: int = 0
@export var tags: int = TAG_BIT_IDLE
@export var isLooping: int = 1
@export var activationPriority: int = 900
@export var interruptPriority: int = 900
@export var allowedStances: int = STANCE_GROUNDED

func main() {
    // ── Execution ───────────────────────────────────────────
    while 1 {
        yield
    }
}
