// ============================================================
// Skill: Idle (skill_idle)
// ============================================================
// Simplest looping script. Yields every frame.
// Activated as fallback when no other skill is active.
// Deactivated when any higher-priority skill activates.

include "common/skill_base.ffs"

// ── Skill Configuration (overrides only) ────────────────────
// All values match skill_base defaults — kept for documentation.
@export const totalFrames: int = -1
@export const activationPriority: int = 900
@export const interruptPriority: int = 900
@export const allowedStances: int = STANCE_GROUNDED

func main() {
    // ── Execution ───────────────────────────────────────────
    while 1 {
        yield
    }
}
