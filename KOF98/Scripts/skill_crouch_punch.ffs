// ============================================================
// Skill: Crouch Punch (skill_crouch_punch)
// ============================================================
// 18-frame crouching attack. Hitbox active during frames [4, 9).
// Script checks for hit within the active window and applies damage.
// Crouching attacks hit low (DMG_NORMAL_LOWER).
// Activation: Down held + LP pressed, grounded.

include "common/skill_base.ffs"

// ── Skill Configuration ─────────────────────────────────────
@export var totalFrames: int = 18
@export var priority: int = 3
@export var tags: int = TAG_BIT_ATTACK
@export var isLooping: int = 0
@export var activationPriority: int = 200
@export var interruptPriority: int = 200
@export var allowedStances: int = STANCE_GROUNDED + STANCE_CROUCHING
@export var requireGrounded: int = 1
@export var requireInputPressed: int = INPUT_BIT_LP
@export var requireInputHeld: int = INPUT_BIT_DOWN

func main() {
    // ── Execution ───────────────────────────────────────────
    BeginAction(20, 18)
    defer {
        EndAction()
    }

    var f: int = 0
    var hitDone: int = 0
    while f < 18 {
        // Hitbox active during frames [4, 9) — group ID 1002
        if f >= 4 && f < 9 && hitDone == 0 {
            var target: int = CheckAttackHit(1002)
            if target > 0 {
                ApplyDamage(target, 1.2, DMG_NORMAL_LOWER)
                ApplyHitstun(target, 0, 10, 0, 0)
                SpawnEffectHit(FX_LIGHT_HIT, FX_DUR_LIGHT_HIT)
                hitDone = 1
            }
        }
        f = f + 1
        yield
    }
}
