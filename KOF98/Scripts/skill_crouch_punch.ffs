// ============================================================
// Skill: Crouch Punch (skill_crouch_punch)
// ============================================================
// 18-frame crouching attack. Hitbox active during frames [4, 9).
// Collision data organized as structs via skill_collision.ffs.
// Crouching attacks hit low (DamageType.NORMAL_LOWER).
// Activation: Down held + LP pressed, grounded.

include "common/skill_base.ffs"

// ── Skill Configuration (overrides only) ────────────────────
@export const totalFrames: int = 18
@export const priority: int = 3
@export const tags: int = TagBit.ATTACK
@export const isLooping: int = 0
@export const activationPriority: int = 200
@export const interruptPriority: int = 200
@export const allowedStances: int = Stance.GROUNDED | Stance.CROUCHING
@export const requireGrounded: int = 1
@export const requireInputPressed: int = InputBit.LP
@export const requireInputHeld: int = InputBit.DOWN

// ── Collision Configuration (Lang-11 module-level struct const) ──
const hitPhase: HitPhaseDef = HitPhaseDef {
    startFrame: 4,
    endFrame: 9,
    groupId: 1002,
    box: Box4 { ox: 0.25, oy: 0.3, hw: 0.3, hh: 0.12 }
}
const hurtBox: Box4 = Box4 { ox: 0.0, oy: 0.35, hw: 0.2, hh: 0.35 }

func main() {
    // ── Execution ───────────────────────────────────────────
    BeginAction(20, 18)
    defer {
        ClearHitbox()
        EndAction()
    }

    var f: int = 0
    var hitDone: int = 0
    while f < 18 {
        // Push collision for this frame
        applyHurtbox(hurtBox)
        clearHitbox()
        pushHitPhase(f, hitPhase)

        // Hit detection during active window
        if f >= hitPhase.startFrame && f < hitPhase.endFrame && hitDone == 0 {
            var target: int = CheckAttackHit(hitPhase.groupId)
            if target > 0 {
                ApplyDamage(target, 1.2, DamageType.NORMAL_LOWER)
                ApplyHitstun(target, 0, 10, 0, 0)
                SpawnEffectHit(FxId.LIGHT_HIT, FxDuration.LIGHT_HIT)
                hitDone = 1
            }
        }
        f = f + 1
        yield
    }
}
