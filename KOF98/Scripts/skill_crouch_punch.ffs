// ============================================================
// Skill: Crouch Punch (skill_crouch_punch)
// ============================================================
// 18-frame crouching attack. Hitbox active during frames [4, 9).
// Script checks for hit within the active window and applies damage.
// Crouching attacks hit low (DMG_NORMAL_LOWER).
// Activation: Down held + LP pressed, grounded.

include "common/skill_base.ffs"

func main() {
    // ── Skill Configuration ─────────────────────────────────
    SetSkillMeta(META_TOTAL_FRAMES, 18)
    SetSkillMeta(META_PRIORITY, 3)
    SetSkillMeta(META_TAGS, 32)
    SetSkillMeta(META_IS_LOOPING, 0)
    SetSkillMeta(META_ACTIVATION_PRIORITY, 200)
    SetSkillMeta(META_INTERRUPT_PRIORITY, 200)
    SetSkillMeta(META_ALLOWED_STANCES, 5)
    SetSkillMeta(META_REQUIRE_GROUNDED, 1)
    SetSkillMeta(META_REQUIRE_INPUT_PRESSED, INPUT_BIT_LP)
    SetSkillMeta(META_REQUIRE_INPUT_HELD, INPUT_BIT_DOWN)

    // ── Execution ───────────────────────────────────────────
    BeginAction(20, 18)
    defer {
        EndAction()
    }

    var f: int = 0
    var hitDone: int = 0
    while f < 18 {
        // Hitbox active during frames [4, 9) — group ID 1002
        if f >= 4 && f < 9 && hitDone == 0 {
            var target: int = CheckAttackHit(1002)
            if target > 0 {
                ApplyDamage(target, 1.2, DMG_NORMAL_LOWER)
                ApplyHitstun(target, 0, 10, 0, 0)
                SpawnEffectHit(FX_LIGHT_HIT, FX_DUR_LIGHT_HIT)
                hitDone = 1
            }
        }
        f = f + 1
        yield
    }
}
