// ============================================================
// Skill: Crouch Punch (skill_crouch_punch)
// Type: Finite (attack)  |  Frames: 18  |  Priority: 200
// ============================================================
// 18-frame crouching attack. Hitbox active during frames [4, 9).
// Script checks for hit within the active window and applies damage.
// Crouching attacks hit low (DMG_NORMAL_LOWER).
//
// Activation condition handled by host (CanActivate: Down+LP pressed + grounded).
//
// Syscalls used: BeginAction, EndAction, CheckAttackHit, ApplyDamage,
//                ApplyHitstun, SpawnEffectHit

include "common/constants.ffs"

func main() {
    BeginAction(20, 18)
    defer {
        EndAction()
    }

    var f: int = 0
    var hitDone: int = 0
    while f < 18 {
        // Hitbox active during frames [4, 9) — group ID 1002
        if f >= 4 && f < 9 && hitDone == 0 {
            var target: int = CheckAttackHit(1002)
            if target > 0 {
                ApplyDamage(target, 1.2, DMG_NORMAL_LOWER)
                ApplyHitstun(target, 0, 10, 0, 0)
                SpawnEffectHit(FX_LIGHT_HIT, 30)
                hitDone = 1
            }
        }
        f = f + 1
        yield
    }
}
