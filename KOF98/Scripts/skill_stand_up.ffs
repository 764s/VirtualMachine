// ============================================================
// Skill: Stand Up (skill_stand_up)
// ============================================================
// 20-frame recovery animation after knockdown.
// Plays the stand-up animation, then returns.
// Once complete, the host transitions back to Idle.
// Activated by host automatically after hard_knockdown completes.

include "common/skill_base.ffs"

// ── Skill Configuration (overrides only) ────────────────────
@export const totalFrames: int = 20
@export const priority: int = 2
@export const tags: int = TAG_BIT_KNOCKDOWN
@export const isLooping: int = 0
@export const activationPriority: int = 80
@export const interruptPriority: int = 80
@export const allowedStances: int = STANCE_KNOCKDOWN

func main() {
    // ── Execution ───────────────────────────────────────────
    BeginAction(31, 20)
    defer {
        EndAction()
    }

    // Wait for stand-up animation to complete
    var f: int = 0
    while f < 20 {
        f = f + 1
        yield
    }
    // Script return → host transitions to Idle
}
