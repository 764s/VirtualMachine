// ============================================================
// Skill: Stand Up (skill_stand_up)
// ============================================================
// 20-frame recovery animation after knockdown.
// Plays the stand-up animation, then returns.
// Once complete, the host transitions back to Idle.
// Activated by host automatically after hard_knockdown completes.

include "common/skill_base.ffs"

func main() {
    // ── Skill Configuration ─────────────────────────────────
    SetSkillMeta(META_TOTAL_FRAMES, 20)
    SetSkillMeta(META_PRIORITY, 2)
    SetSkillMeta(META_TAGS, 512)
    SetSkillMeta(META_IS_LOOPING, 0)
    SetSkillMeta(META_ACTIVATION_PRIORITY, 80)
    SetSkillMeta(META_INTERRUPT_PRIORITY, 80)
    SetSkillMeta(META_ALLOWED_STANCES, STANCE_KNOCKDOWN)

    // ── Execution ───────────────────────────────────────────
    BeginAction(31, 20)
    defer {
        EndAction()
    }

    // Wait for stand-up animation to complete
    var f: int = 0
    while f < 20 {
        f = f + 1
        yield
    }
    // Script return → host transitions to Idle
}
