{
    "name": "FFVM Script",
    "scopeName": "source.ffvm",
    "fileTypes": ["ffvm"],
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#numbers" },
        { "include": "#functions" },
        { "include": "#operators" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.ffvm",
                    "match": "//.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.ffvm",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.ffvm",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.ffvm",
                    "match": "\\b(if|else|while|for|return|yield|wait|wait_for|defer|using|break|continue)\\b"
                },
                {
                    "name": "keyword.declaration.ffvm",
                    "match": "\\b(func|var|struct)\\b"
                },
                {
                    "name": "constant.language.ffvm",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "support.type.ffvm",
                    "match": "\\b(int|bool|void)\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.ffvm",
                    "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.ffvm",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.ffvm",
                    "match": "(==|!=|<=|>=|&&|\\|\\||!|\\+|-|\\*|/|%|<|>|=)"
                }
            ]
        }
    }
}
