{
    "name": "FFVM Script",
    "scopeName": "source.ffvm",
    "fileTypes": [
        "ffs",
        "ffvm"
    ],
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#annotations"
        },
        {
            "include": "#func-declaration"
        },
        {
            "include": "#struct-declaration"
        },
        {
            "include": "#enum-declaration"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#enum-qualified-access"
        },
        {
            "include": "#type-annotations"
        },
        {
            "include": "#types"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.documentation.ffvm",
                    "match": "///.*$"
                },
                {
                    "name": "comment.line.double-slash.ffvm",
                    "match": "//.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.ffvm",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.ffvm",
                            "match": "\\\\[nt\\\\\"]"
                        }
                    ]
                }
            ]
        },
        "annotations": {
            "patterns": [
                {
                    "name": "entity.name.function.preprocessor.ffvm",
                    "match": "@(export|inline)\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.ffvm",
                    "match": "\\b(if|else|while|for|return|yield|wait_for|wait|defer|using)\\b"
                },
                {
                    "name": "keyword.other.ffvm",
                    "match": "\\b(func|var|const|struct|enum|include|external)\\b"
                },
                {
                    "name": "storage.modifier.ffvm",
                    "match": "\\b(public|private|override)\\b"
                },
                {
                    "name": "constant.language.ffvm",
                    "match": "\\b(true|false|null)\\b"
                }
            ]
        },
        "func-declaration": {
            "patterns": [
                {
                    "comment": "Function declaration: func name(",
                    "match": "\\b(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": { "name": "keyword.other.ffvm" },
                        "2": { "name": "entity.name.function.ffvm" }
                    }
                }
            ]
        },
        "struct-declaration": {
            "patterns": [
                {
                    "comment": "Struct name in declaration: struct Name {",
                    "match": "\\b(struct)\\s+([A-Z][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.other.ffvm" },
                        "2": { "name": "entity.name.type.struct.ffvm" }
                    }
                }
            ]
        },
        "enum-declaration": {
            "patterns": [
                {
                    "comment": "Enum name in declaration: enum Name {",
                    "match": "\\b(enum)\\s+([A-Z][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.other.ffvm" },
                        "2": { "name": "entity.name.type.enum.ffvm" }
                    }
                }
            ]
        },
        "enum-qualified-access": {
            "patterns": [
                {
                    "comment": "Qualified enum member: DamageType.NORMAL_LOWER",
                    "match": "\\b([A-Z][a-zA-Z0-9_]*)\\s*\\.\\s*([A-Z][A-Z0-9_]*)\\b",
                    "captures": {
                        "1": { "name": "entity.name.type.enum.ffvm" },
                        "2": { "name": "variable.other.enummember.ffvm" }
                    }
                }
            ]
        },
        "type-annotations": {
            "patterns": [
                {
                    "comment": "Type annotation after colon: var x: TypeName",
                    "match": ":\\s*([A-Z][a-zA-Z0-9_]*)\\b",
                    "captures": {
                        "1": { "name": "entity.name.type.ffvm" }
                    }
                },
                {
                    "comment": "Type name before dot-access (not enum qualified): TypeName.member",
                    "match": "\\b([A-Z][a-zA-Z0-9_]*)\\s*\\.\\s*(?![A-Z][A-Z0-9_]*\\b)",
                    "captures": {
                        "1": { "name": "entity.name.type.ffvm" }
                    }
                },
                {
                    "comment": "Type name in struct literal: TypeName {",
                    "match": "\\b([A-Z][a-zA-Z0-9_]*)\\s*\\{",
                    "captures": {
                        "1": { "name": "entity.name.type.ffvm" }
                    }
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "keyword.type.ffvm",
                    "match": "\\b(int|float|bool|void)\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.ffvm",
                    "match": "\\b[0-9]+\\.[0-9]+\\b"
                },
                {
                    "name": "constant.numeric.integer.ffvm",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "comment": "Function call: name(",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": { "name": "entity.name.function.ffvm" }
                    }
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.ffvm",
                    "match": "(==|!=|<=|>=|&&|\\|\\||!|\\+|-|\\*|/|%|<|>|=)"
                }
            ]
        }
    }
}
