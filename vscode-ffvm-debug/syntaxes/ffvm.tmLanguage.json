{
    "name": "FFVM Script",
    "scopeName": "source.ffvm",
    "fileTypes": [
        "ffs",
        "ffvm"
    ],
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#annotations"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#struct-declaration"
        },
        {
            "include": "#enum-declaration"
        },
        {
            "include": "#types"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#type-annotations"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.documentation.ffvm",
                    "match": "///.*$"
                },
                {
                    "name": "comment.line.double-slash.ffvm",
                    "match": "//.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.ffvm",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.ffvm",
                            "match": "\\\\[nt\\\\\"]"
                        }
                    ]
                }
            ]
        },
        "annotations": {
            "patterns": [
                {
                    "name": "storage.modifier.ffvm",
                    "match": "@(export|inline)\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.ffvm",
                    "match": "\\b(if|else|while|for|return|yield|wait_for|wait|defer|using)\\b"
                },
                {
                    "name": "keyword.declaration.ffvm",
                    "match": "\\b(func|var|const|struct|enum|include)\\b"
                },
                {
                    "name": "storage.modifier.ffvm",
                    "match": "\\b(public|private|override)\\b"
                },
                {
                    "name": "constant.language.ffvm",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "struct-declaration": {
            "patterns": [
                {
                    "comment": "Struct name in declaration: struct Name {",
                    "match": "\\b(struct)\\s+([A-Z][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.declaration.ffvm" },
                        "2": { "name": "entity.name.type.struct.ffvm" }
                    }
                }
            ]
        },
        "enum-declaration": {
            "patterns": [
                {
                    "comment": "Enum name in declaration: enum Name {",
                    "match": "\\b(enum)\\s+([A-Z][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.declaration.ffvm" },
                        "2": { "name": "entity.name.type.enum.ffvm" }
                    }
                }
            ]
        },
        "type-annotations": {
            "patterns": [
                {
                    "comment": "Type annotation after colon: var x: TypeName",
                    "match": ":\\s*([A-Z][a-zA-Z0-9_]*)\\b",
                    "captures": {
                        "1": { "name": "entity.name.type.ffvm" }
                    }
                },
                {
                    "comment": "Type name before dot-access: TypeName.member",
                    "match": "\\b([A-Z][a-zA-Z0-9_]*)\\s*\\.",
                    "captures": {
                        "1": { "name": "entity.name.type.ffvm" }
                    }
                },
                {
                    "comment": "Type name in struct literal: TypeName {",
                    "match": "\\b([A-Z][a-zA-Z0-9_]*)\\s*\\{",
                    "captures": {
                        "1": { "name": "entity.name.type.ffvm" }
                    }
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "support.type.ffvm",
                    "match": "\\b(int|float|bool|void)\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.ffvm",
                    "match": "\\b[0-9]+\\.[0-9]+\\b"
                },
                {
                    "name": "constant.numeric.integer.ffvm",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.ffvm",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.ffvm",
                    "match": "(==|!=|<=|>=|&&|\\|\\||!|\\+|-|\\*|/|%|<|>|=)"
                }
            ]
        }
    }
}
