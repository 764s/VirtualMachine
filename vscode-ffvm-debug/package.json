{
    "name": "ffvm-debug",
    "displayName": "FFVM Script Debugger",
    "description": "Debug adapter and language server for FFVM bytecode scripts",
    "version": "0.2.0",
    "publisher": "ffvm",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Debuggers",
        "Programming Languages"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:ffvm"
    ],
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "contributes": {
        "debuggers": [
            {
                "type": "ffvm",
                "label": "FFVM Script",
                "program": "${workspaceFolder}/StandaloneRunner/bin/Release/net8.0/StandaloneRunner",
                "args": ["--dap"],
                "runtime": "",
                "languages": ["ffvm"],
                "configurationAttributes": {
                    "launch": {
                        "required": ["program"],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "Absolute path to the .ffs script file to debug",
                                "default": "${workspaceFolder}/script.ffs"
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "ffvm",
                        "request": "launch",
                        "name": "Debug FFVM Script",
                        "program": "${workspaceFolder}/script.ffs"
                    }
                ]
            }
        ],
        "breakpoints": [
            {
                "language": "ffvm"
            }
        ],
        "languages": [
            {
                "id": "ffvm",
                "aliases": ["FFScript", "ffvm"],
                "extensions": [".ffs", ".ffvm"],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "ffvm",
                "scopeName": "source.ffvm",
                "path": "./syntaxes/ffvm.tmLanguage.json"
            }
        ]
    }
}
