{
    "name": "ffvm-debug",
    "displayName": "FFVM Script Debugger",
    "description": "Debug adapter and language server for FFVM bytecode scripts",
    "version": "0.2.0",
    "publisher": "ffvm",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Debuggers",
        "Programming Languages"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onDebugResolve:ffvm"
    ],
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "contributes": {
        "configuration": {
            "title": "FFVM",
            "properties": {
                "ffvm.executablePath": {
                    "type": "string",
                    "default": "ffvm-cli",
                    "description": "Path to the ffvm-cli executable. Defaults to searching in PATH."
                },
                "ffvm.lspMode": {
                    "type": "string",
                    "enum": [
                        "new",
                        "legacy"
                    ],
                    "default": "new",
                    "description": "Choose LSP server implementation. 'new' uses database-backed LspServerNew, 'legacy' uses original LspServer."
                }
            }
        },
        "debuggers": [
            {
                "type": "ffvm",
                "label": "FFVM Script",
                "languages": ["ffvm"],
                "configurationAttributes": {
                    "launch": {
                        "required": ["program"],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "Absolute path to the .ffs script file to debug",
                                "default": "${workspaceFolder}/script.ffs"
                            }
                        }
                    },
                    "attach": {
                        "properties": {
                            "port": {
                                "type": "number",
                                "description": "TCP port of the embedded DAP server in Sandbox",
                                "default": 4711
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "ffvm",
                        "request": "attach",
                        "name": "Attach to Sandbox",
                        "port": 4711
                    }
                ]
            }
        ],
        "breakpoints": [
            {
                "language": "ffvm"
            }
        ],
        "languages": [
            {
                "id": "ffvm",
                "aliases": ["FFScript", "ffvm"],
                "extensions": [".ffs", ".ffvm"],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "ffvm",
                "scopeName": "source.ffvm",
                "path": "./syntaxes/ffvm.tmLanguage.json"
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "ffvm",
                "scopes": {
                    "namespace": ["entity.name.namespace.ffvm"],
                    "type": ["entity.name.type.struct.ffvm"],
                    "enum": ["entity.name.type.enum.ffvm"],
                    "function": ["entity.name.function.ffvm"],
                    "variable": ["variable.other.ffvm"],
                    "parameter": ["variable.parameter.ffvm"],
                    "property": ["variable.other.property.ffvm"],
                    "enumMember": ["variable.other.enummember.ffvm"],
                    "keyword": ["keyword.other.ffvm"]
                }
            }
        ]
    }
}
