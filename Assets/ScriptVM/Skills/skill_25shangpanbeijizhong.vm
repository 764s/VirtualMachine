// ============================================================
// 技能: 上盘被击中 (skill_25shangpanbeijizhong)
// Id: 290253  |  类型: 受击  |  帧数: 30  |  循环: 否
// 优先级: 受击 (1)
// Tags: [受击]
// ============================================================
//
// 启动条件 (由宿主在实例化此脚本前检查, 组间OR/组内AND):
//   条件组[0]:
//     AND: 受到伤害类型 ∈ [普通地面+上盘重击, 普通空中+上盘重击]
//     AND: 自身不处于 [蹲状态]
//     AND: 无 [免受击] Buff标记
//
// 注意: 启动条件由技能切换层(SkillBehaviour)评估,
//       脚本本身假设条件已通过, 仅负责受击动作执行.
//
// 宿主 Syscall 协议:
//   BeginAction(actionId, totalFrames)
//   EndAction()
//   SpawnEffectSelf(effectId, durF)
// ============================================================

func main() {
    // --- 受击技能初始化 ---
    BeginAction(25, 30)
    defer {
        EndAction()
    }

    // 子技能[0]: 受击视觉效果 (无条件, 目标:自身)
    // 预制体: cgh_shouzhongji, 持续300帧
    SpawnEffectSelf(4001, 300)

    // --- 等待受击动作播放完毕 (30帧) ---
    var f: int = 0
    while f < 30 {
        f = f + 1
        yield
    }
}
